@page
@model DashboardModel
@using Microsoft.AspNetCore.Http

<div class="container py-4">
    <h2 class="text-center mb-5 fw-bold tracking-wide text-gradient-onus" style="letter-spacing: 2px;">SELECT ATHLETE</h2>
    <div class="row g-4">
        @foreach (var atleta in Model.Atleti)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card player-tile text-center p-4 h-100 d-flex flex-column justify-content-center position-relative bg-dark"
                     style="border: 1px solid rgba(0, 160, 255, 0.2); transition: all 0.3s; cursor:pointer;"
                     onmouseover="this.style.boxShadow='0 0 15px rgba(0, 160, 255, 0.4)'; this.style.transform='scale(1.03)';"
                     onmouseout="this.style.boxShadow='none'; this.style.transform='scale(1)';"
                     onclick="apriModale(@atleta.Id, '@atleta.Nome @atleta.Cognome')">

                    <div class="mb-3">
                        <img src="@atleta.FotoUrl" class="rounded-circle" width="100" height="100" style="object-fit: cover; border: 2px solid var(--onus-green); padding: 2px;" />
                    </div>
                    <h4 class="fw-bold m-0 text-white">@atleta.Nome</h4>
                    <p class="text-muted text-uppercase small fw-bold ls-1 mb-3">@atleta.Cognome</p>

                    @if (atleta.IsInfortunato || atleta.IsInRiabilitazione)
                    {
                        <div class="mt-auto" onclick="event.stopPropagation();">
                            @if (atleta.IsInfortunato)
                            {
                                <button type="button" class="btn btn-sm w-100 fw-bold shadow-sm" style="background-color: #ff4757; color: white; border: none;"
                                        data-bs-toggle="modal" data-bs-target="#modalStatus-@atleta.Id">
                                    Injured
                                </button>
                            }
                            else if (atleta.IsInRiabilitazione)
                            {
                                <button type="button" class="btn btn-sm text-dark w-100 fw-bold shadow-sm" style="background-color: #ffa502; border: none;"
                                        data-bs-toggle="modal" data-bs-target="#modalStatus-@atleta.Id">
                                    In Rehab
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (atleta.IsInfortunato || atleta.IsInRiabilitazione)
                {
                    <div class="modal fade" id="modalStatus-@atleta.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary" style="border: 1px solid rgba(255, 71, 87, 0.5);">
                                <div class="modal-header border-secondary">
                                    <h5 class="modal-title fw-bold" style="color: @(atleta.IsInfortunato ? "#ff4757" : "#ffa502")">
                                        @(atleta.IsInfortunato ? "Injury" : "Rehab"): @atleta.Nome @atleta.Cognome
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-start">
                                    <h6 class="text-muted text-uppercase ls-1 small">Details / Notes</h6>
                                    @if (string.IsNullOrWhiteSpace(atleta.DescrizioneInfortunio))
                                    {
                                        <p class="fst-italic text-secondary mt-2">No description available for this player.</p>
                                    }
                                    else
                                    {
                                        <p class="mt-2 fs-5">@atleta.DescrizioneInfortunio</p>
                                    }
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="inputModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white shadow-lg" style="border: 2px solid var(--onus-blue);">
            <div class="modal-header border-0 pb-0">
                <div>
                    <small class="text-white-50 text-uppercase ls-1">Athlete</small>
                    <h2 class="modal-title fw-bold text-gradient-onus" id="lblNomeGiocatore">Player</h2>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <form method="post" id="formDati">
                    <input type="hidden" id="hiddenAtletaId" name="AtletaId" />

                    @foreach (var param in Model.ParametriDashboard)
                    {
                        <input type="hidden" id="val_@param.Id" name="ValoriParametri[@param.Id]" data-is-rpe="@param.IsCalcoloCarico.ToString().ToLower()" />
                    }

                    <div class="row g-4">
                        <div class="col-md-6 d-flex flex-column gap-2">
                            @foreach (var param in Model.ParametriDashboard)
                            {
                                <div class="param-btn d-flex justify-content-between align-items-center bg-black border border-secondary rounded-3 p-3"
                                     id="btn_@param.Id"
                                     onclick="selezionaCampo(@param.Id)"
                                     style="cursor: pointer; transition: all 0.2s;">
                                    <span class="fs-5">
                                        @if (param.IsCalcoloCarico)
                                        {
                                            <span>🔥</span>
                                        }
                                        else
                                        {

                                            <span>📊</span>
                                        }
                                        @param.Nome
                                        <small class="text-white-50 d-block" style="font-size:0.75em; margin-top:-5px;">(Range @param.ValoreMinimo to @param.ValoreMassimo)</small>
                                    </span>
                                    <span class="fs-2 fw-bold text-gradient-onus" id="display_@param.Id">-</span>
                                </div>
                            }

                            <div class="mt-2">
                                <textarea name="Note" class="form-control bg-black text-white border-secondary shadow-sm" rows="3" placeholder="Add a training note..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-outline-onus rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalGuidaImmagine">
                                    <i class="bi bi-info-circle me-1"></i> RPE Scale
                                </button>
                            </div>

                            <div class="row g-2 mb-3">
                                <style>
                                                                    .btn-cyber-pad {
                                                                        background: #1a1a1a;
                                                                        color: white;
                                                                        border: 1px solid #333;
                                                                        transition: all 0.1s;
                                                                    }

                                                                        .btn-cyber-pad:active {
                                                                            background: var(--onus-green);
                                                                            color: black;
                                                                            border-color: var(--onus-green);
                                                                            transform: scale(0.95);
                                                                        }
                                </style>
                                @for (int i = 1; i <= 9; i++)
                                {
                                    <div class="col-4"><button type="button" class="btn btn-cyber-pad w-100 py-3 fs-3 fw-bold rounded-3 shadow-sm" onclick="digita(@i)">@i</button></div>
                                }
                                <div class="col-4"><button type="button" class="btn btn-cyber-pad w-100 py-3 fw-bold fs-4 rounded-3 shadow-sm" style="color: #ff4757;" onclick="cancella()">⌫</button></div>
                                <div class="col-4"><button type="button" class="btn btn-cyber-pad w-100 py-3 fs-3 fw-bold rounded-3 shadow-sm" onclick="digita(0)">0</button></div>
                                <div class="col-4"><button type="button" class="btn btn-cyber-pad w-100 py-3 fw-bold text-info rounded-3 shadow-sm" onclick="prossimoCampo()">NEXT</button></div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-onus py-3 fw-bold fs-5 text-uppercase shadow-lg rounded-pill" style="letter-spacing: 1px;">
                                    Save Data <i class="bi bi-check2-circle ms-1"></i>
                                </button>
                                <a href="#" id="btnVediGrafici" class="btn btn-link text-white-50 text-decoration-none py-2 small">Go to Player Analysis -></a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalGuidaImmagine" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-gradient-onus fw-bold">Reference Scale</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-toggle="modal" data-bs-target="#inputModal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img src="~/Img/info.jpeg" alt="Guide" class="img-fluid rounded shadow" style="border: 2px solid var(--onus-blue);" />
                <p class="mt-3 text-white-50 small">Refer to this scale to accurately assess intensity (RPE).</p>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-onus rounded-pill fw-bold px-4" data-bs-toggle="modal" data-bs-target="#inputModal">I understand</button>
            </div>
        </div>
    </div>
</div>

@if (HttpContext.Session.GetString("Ruolo") == "Atleta")
{
    <div class="modal fade" id="modalNotificheAutomatico" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary text-center shadow-lg" style="border: 1px solid var(--onus-green) !important;">
                <div class="modal-header border-secondary justify-content-center">
                    <h5 class="modal-title text-gradient-onus fw-bold fs-4">🔔 Stay Updated!</h5>
                </div>
                <div class="modal-body p-4">
                    <p class="fs-5">Do you want to receive a reminder to enter your data after training?</p>
                    <p class="text-white-50 small mb-4">Click "Activate Now" and then "Allow" in the next prompt.</p>

                    <button class="btn btn-onus btn-lg w-100 mb-3 fw-bold rounded-pill shadow" onclick="richiediPermessoNotifiche()" data-bs-dismiss="modal">
                        Activate Now <i class="bi bi-rocket-takeoff ms-1"></i>
                    </button>
                    <button class="btn btn-outline-secondary w-100 rounded-pill" data-bs-dismiss="modal">
                        Maybe later
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    var paramIds = [@string.Join(",", Model.ParametriDashboard.Select(p => p.Id))];
    var currentParamId = null;
    var modalInput;

    function apriModale(id, nome) {
        document.getElementById('hiddenAtletaId').value = id;
        document.getElementById('lblNomeGiocatore').innerText = nome;
        document.querySelector('textarea[name="Note"]').value = '';

        paramIds.forEach(pid => {
            let valInput = document.getElementById('val_' + pid);
            let displaySpan = document.getElementById('display_' + pid);
            if(valInput) valInput.value = '';
            if(displaySpan) displaySpan.innerText = '-';
        });

        var linkGrafici = document.getElementById('btnVediGrafici');
        if(linkGrafici) linkGrafici.href = '/Analisi?atletaId=' + id;

        if(paramIds.length > 0) {
            selezionaCampo(paramIds[0]);
        }

        if (!modalInput) modalInput = new bootstrap.Modal(document.getElementById('inputModal'));
        modalInput.show();
    }

    function selezionaCampo(id) {
        currentParamId = id;
        document.querySelectorAll('.param-btn').forEach(el => {
            el.style.borderColor = '#6c757d';
            el.style.backgroundColor = 'black';
        });
        var btn = document.getElementById('btn_' + id);
        if(btn) {
            btn.style.borderColor = 'var(--onus-green)';
            btn.style.backgroundColor = '#1a1a1a';
        }
    }

    function digita(num) {
        if(currentParamId === null) return;
        let hiddenInput = document.getElementById('val_' + currentParamId);
        let displaySpan = document.getElementById('display_' + currentParamId);

        let valAttuale = hiddenInput.value;
        let nuovoValore = valAttuale + num.toString();

        if (parseInt(nuovoValore) <= 10) {
            hiddenInput.value = nuovoValore;
            displaySpan.innerText = nuovoValore;
        } else if (num <= 10) {
            hiddenInput.value = num;
            displaySpan.innerText = num;
        }
    }

    function cancella() {
        if(currentParamId === null) return;
        let hiddenInput = document.getElementById('val_' + currentParamId);
        let displaySpan = document.getElementById('display_' + currentParamId);
        hiddenInput.value = '';
        displaySpan.innerText = '-';
    }

    function prossimoCampo() {
        if(currentParamId === null) return;
        let idx = paramIds.indexOf(currentParamId);
        if (idx >= 0 && idx < paramIds.length - 1) {
            selezionaCampo(paramIds[idx + 1]);
        }
    }

    document.getElementById('formDati').addEventListener('submit', function(e) {
        let rpeInput = document.querySelector('input[data-is-rpe="true"]');
        if (rpeInput && rpeInput.value === '') {
            e.preventDefault();
            alert("Warning: The RPE value (🔥) is mandatory to save the training session.");
            let rpeId = rpeInput.id.split('_')[1];
            selezionaCampo(parseInt(rpeId));
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        var tiles = document.querySelectorAll('.player-tile');
        if (tiles.length === 1) {
            setTimeout(function() {
                tiles[0].click();
            }, 150);
        }
    });
</script>

@section Scripts {
    <script>
        const applicationServerPublicKey = 'INCOLLA_QUI_LA_TUA_PUBLIC_KEY';

        document.addEventListener("DOMContentLoaded", function() {
            if ('Notification' in window && Notification.permission === 'default') {
                var modaleHtml = document.getElementById('modalNotificheAutomatico');
                if (modaleHtml) {
                    setTimeout(() => {
                        var myModal = new bootstrap.Modal(modaleHtml);
                        myModal.show();
                    }, 500);
                }
            }
        });

        function urlB64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            return outputArray;
        }

        async function richiediPermessoNotifiche() {
            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                alert('Your browser or device does not support Push notifications.');
                return;
            }

            try {
                const permission = await Notification.requestPermission();

                if (permission !== 'granted') {
                    console.log('Notifications blocked by user.');
                    return;
                }

                const registration = await navigator.serviceWorker.register('/service-worker.js');
                const applicationServerKey = urlB64ToUint8Array(applicationServerPublicKey);
                const subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey: applicationServerKey
                });

                const response = await fetch('/api/Push/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(subscription)
                });

                if (response.ok) {
                    alert('Notifications activated successfully! 🎉');
                } else {
                    console.error('Server error:', response);
                    alert('Error saving to the database.');
                }

            } catch (error) {
                console.error('Subscription error:', error);
                alert('An error occurred.');
            }
        }
    </script>
}