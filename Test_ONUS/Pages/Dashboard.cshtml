@page
@model DashboardModel

<div class="container py-4">
    <h2 class="text-center mb-5 fw-bold text-white tracking-wide">SELEZIONA ATLETA</h2>
    <div class="row g-4">
        @foreach (var atleta in Model.Atleti)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card player-tile text-center p-4 h-100 d-flex flex-column justify-content-center position-relative"
                     onclick="apriModale(@atleta.Id, '@atleta.Nome @atleta.Cognome')">

                    <div class="mb-3">
                        <img src="@atleta.FotoUrl" class="rounded-circle shadow-lg" width="100" height="100" style="object-fit: cover;" />
                    </div>
                    <h4 class="fw-bold m-0 text-white">@atleta.Nome</h4>
                    <p class="text-muted text-uppercase small fw-bold ls-1 mb-3">@atleta.Cognome</p>

                    @if (atleta.IsInfortunato || atleta.IsInRiabilitazione)
                    {
                        <div class="mt-auto" onclick="event.stopPropagation();">
                            @if (atleta.IsInfortunato)
                            {
                                <button type="button" class="btn btn-sm btn-danger w-100 fw-bold shadow-sm"
                                        data-bs-toggle="modal" data-bs-target="#modalStatus-@atleta.Id">
                                    Infortunato
                                </button>
                            }
                            else if (atleta.IsInRiabilitazione)
                            {
                                <button type="button" class="btn btn-sm btn-warning text-dark w-100 fw-bold shadow-sm"
                                        data-bs-toggle="modal" data-bs-target="#modalStatus-@atleta.Id">
                                    In Riabilitazione
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (atleta.IsInfortunato || atleta.IsInRiabilitazione)
                {
                    <div class="modal fade" id="modalStatus-@atleta.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header border-secondary">
                                    <h5 class="modal-title fw-bold">
                                        @(atleta.IsInfortunato ? "Infortunio" : "Riabilitazione"): @atleta.Nome @atleta.Cognome
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-start">
                                    <h6 class="text-muted text-uppercase ls-1 small">Descrizione / Note</h6>
                                    @if (string.IsNullOrWhiteSpace(atleta.DescrizioneInfortunio))
                                    {
                                        <p class="fst-italic text-secondary mt-2">Nessuna descrizione presente per questo giocatore.</p>
                                    }
                                    else
                                    {
                                        <p class="mt-2 fs-5">@atleta.DescrizioneInfortunio</p>
                                    }
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="inputModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-0 pb-0">
                <div>
                    <small class="text-muted text-uppercase ls-1">Atleta</small>
                    <h2 class="modal-title fw-bold text-white" id="lblNomeGiocatore">Giocatore</h2>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <form method="post" id="formDati">
                    <input type="hidden" id="hiddenAtletaId" name="AtletaId" />

                    @foreach (var param in Model.ParametriDashboard)
                    {
                        <input type="hidden" id="val_@param.Id" name="ValoriParametri[@param.Id]" data-is-rpe="@param.IsCalcoloCarico.ToString().ToLower()" />
                    }

                    <div class="row g-4">
                        <div class="col-md-6 d-flex flex-column gap-2">
                            @foreach (var param in Model.ParametriDashboard)
                            {
                                <div class="param-btn d-flex justify-content-between align-items-center"
                                     id="btn_@param.Id"
                                     onclick="selezionaCampo(@param.Id)">
                                    <span class="fs-5">
                                        @if (param.IsCalcoloCarico)
                                        {
                                            <span>🔥</span>
                                        }
                                        else
                                        {

                                            <span>📊</span>
                                        }
                                        @param.Nome
                                        <small class="text-muted" style="font-size:0.7em;">(@param.ValoreMinimo-@param.ValoreMassimo)</small>
                                    </span>
                                    <span class="fs-3 fw-bold text-white" id="display_@param.Id">-</span>
                                </div>
                            }

                            <div class="mt-2">
                                <textarea name="Note" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Note opzionali..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">

                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalGuidaImmagine">
                                    ℹ️ Guida Scala Sforzo
                                </button>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(1)">1</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(2)">2</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(3)">3</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(4)">4</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(5)">5</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(6)">6</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(7)">7</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(8)">8</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(9)">9</button></div>
                                <div class="col-4"><button type="button" class="btn btn-outline-secondary w-100 py-3 fw-bold" onclick="cancella()">⌫</button></div>
                                <div class="col-4"><button type="button" class="btn numpad-btn w-100 py-3 fs-4" onclick="digita(0)">0</button></div>
                                <div class="col-4"><button type="button" class="btn btn-light w-100 py-3 fw-bold text-dark" onclick="prossimoCampo()">Next</button></div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger py-3 fw-bold fs-5 text-uppercase shadow-lg" style="letter-spacing: 1px;">Salva Dati</button>
                                <a href="#" id="btnVediGrafici" class="btn btn-outline-secondary py-2 small">Vedi grafici</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalGuidaImmagine" tabindex="-1" aria-labelledby="modalGuidaImmagineLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="modalGuidaImmagineLabel">Scala di Riferimento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-toggle="modal" data-bs-target="#inputModal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body text-center">
                <img src="~/Img/guida-obiettivo.jpg" alt="Guida Obiettivo" class="img-fluid rounded shadow" />

                <p class=" mt-3