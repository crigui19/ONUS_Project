@page
@model Test_ONUS.Pages.LoginModel
@{
    ViewData["Title"] = "Login - ONUS";
}

<div class="d-flex align-items-center justify-content-center" style="height: 80vh;">
    <div class="card shadow p-4 text-center" style="width: 100%; max-width: 400px;">
        <h2 class="mb-4 text-danger fw-bold">ACCESSO ONUS</h2>

        <form method="post">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="username" name="username" placeholder="Nome" required />
                <label for="username">Nome Utente (es. LeBron)</label>
            </div>
            <div class="form-floating mb-3">
                <input type="password" class="form-control" id="password" name="password" placeholder="Password" required />
                <label for="password">Password</label>
            </div>

            @* CORREZIONE QUI: Usiamo ErrorMsg invece di MessaggioErrore *@
            @if (!string.IsNullOrEmpty(Model.ErrorMsg))
            {
                <div class="alert alert-danger py-2 mb-3">@Model.ErrorMsg</div>
            }

            <button type="submit" class="btn btn-danger w-100 py-3 fw-bold fs-5">ENTRA</button>
        </form>
        <div class="text-center mt-4 border-top border-secondary pt-3">
            <p class="text-white-50 mb-1">Non hai ancora una squadra su ONUS?</p>
            <a href="/Registrazione" class="text-danger fw-bold text-decoration-none">
                REGISTRA UNA NUOVA SQUADRA <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>
</div>