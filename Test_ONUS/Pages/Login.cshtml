@page
@model Test_ONUS.Pages.LoginModel
@{
    ViewData["Title"] = "Login - ONUS";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card bg-dark text-white p-4 text-center shadow-lg" style="width: 100%; max-width: 500px; border: 1px solid rgba(0, 160, 255, 0.3); box-shadow: 0 0 20px rgba(0, 160, 255, 0.1) !important;">

        <div class="mb-4">
            <!-- Logo display -->
            <img src="~/Img/logo-onus.jpeg" alt="ONUS Logo" width="70" height="70" class="rounded-circle mb-3 border border-secondary shadow-sm">
            <h2 class="text-gradient-onus fw-bold m-0 tracking-wide" style="letter-spacing: 1px;">ONUS ACCESS</h2>
        </div>

        <form method="post">
            <div class="form-floating mb-4 text-start">
                <input asp-for="Username" type="text" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Username" required />
                <label asp-for="Username" class="text-white-50">Username</label>
            </div>

            <div class="form-floating mb-4 text-start">
                <input asp-for="Password" type="password" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Password" required />
                <label asp-for="Password" class="text-white-50">Password</label>
            </div>

            <!-- Nuovo link per recupero password -->
            <div class="text-end mb-3">
                <a href="/RecuperoPassword" class="text-white-50 small text-decoration-none" style="transition: color 0.2s;" onmouseover="this.style.color='var(--onus-blue)'" onmouseout="this.style.color='rgba(255,255,255,0.5)'">Forgot Password?</a>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMsg))
            {
                <div class="alert bg-danger bg-opacity-25 border border-danger text-white py-2 mb-3 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@Model.ErrorMsg
                </div>
            }

            <button type="submit" class="btn btn-onus w-100 py-3 fw-bold fs-5 rounded-pill shadow-lg mt-3">
                LOGIN <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-4 border-top border-secondary pt-3">
            <p class="text-white-50 mb-2">Don't have a team on ONUS yet?</p>
            <a href="/Registrazione" class="fw-bold text-decoration-none d-inline-block" style="color: var(--onus-blue); transition: transform 0.2s;">
                REGISTER A NEW TEAM <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>
</div>