@page
@model Test_ONUS.Pages.LoginModel
@{
    ViewData["Title"] = "Login - ONUS";
}

<div class="d-flex align-items-center justify-content-center" style="height: 80vh;">
    <!-- Card scura con bordo sottile azzurro e ombra a tema -->
    <div class="card bg-dark text-white p-4 text-center" style="width: 100%; max-width: 400px; border: 1px solid rgba(0, 160, 255, 0.3); box-shadow: 0 0 20px rgba(0, 160, 255, 0.1);">

        <div class="mb-4">
            <!-- Richiamo del logo -->
            <img src="~/Img/logo-onus.jpeg" alt="ONUS Logo" width="70" height="70" class="rounded-circle mb-3 border border-secondary shadow-sm">
            <h2 class="text-gradient-onus fw-bold m-0 tracking-wide" style="letter-spacing: 1px;">ACCESSO ONUS</h2>
        </div>

        <form method="post">
            <div class="form-floating mb-3 text-start">
                <input type="text" class="form-control bg-black text-white shadow-sm" id="username" name="username" placeholder="Nome" required />
                <label for="username">Nome Utente</label>
            </div>
            <div class="form-floating mb-3 text-start">
                <input type="password" class="form-control bg-black text-white shadow-sm" id="password" name="password" placeholder="Password" required />
                <label for="password">Password</label>
            </div>

            @* CORREZIONE QUI: Usiamo ErrorMsg invece di MessaggioErrore *@
            @if (!string.IsNullOrEmpty(Model.ErrorMsg))
            {
                <div class="alert bg-danger bg-opacity-25 border border-danger text-white py-2 mb-3 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@Model.ErrorMsg
                </div>
            }

            <button type="submit" class="btn btn-onus w-100 py-3 fw-bold fs-5 rounded-pill shadow-lg mt-3">
                ENTRA <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-4 border-top border-secondary pt-3">
            <p class="text-white-50 mb-2">Non hai ancora una squadra su ONUS?</p>
            <a href="/Registrazione" class="fw-bold text-decoration-none d-inline-block" style="color: var(--onus-blue); transition: transform 0.2s;">
                REGISTRA UNA NUOVA SQUADRA <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>
</div>