@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - ONUS</title>

    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#00a0ff"> <!-- Aggiornato all'azzurro -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ONUS">
    <!-- Puoi sostituire questa icona con il tuo nuovo logo quadrato in futuro -->
    <link rel="apple-touch-icon" href="~/img/icon-192.png">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Test_ONUS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-dark text-white">
    <!-- Loader Aggiornato -->
    <div id="loading-overlay">
        <div class="loader"></div>
        <div class="loading-text text-gradient-onus fw-bold fs-3">ONUS</div>
    </div>

    <header>
        <!-- Navbar con border verde/azzurro -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-black mb-3 shadow" style="border-bottom: 2px solid #00a0ff;">
            <div class="container">
                <!-- IL NUOVO LOGO -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/Img/logo-onus.jpeg" alt="ONUS" width="40" height="40" class="rounded-circle me-2 border border-secondary shadow-sm">
                    <span class="text-gradient-onus fw-bold fs-4 tracking-wider" style="letter-spacing: 2px;">ONUS</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("Ruolo") == "Staff")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Dashboard">@Localizer["Dashboard"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Analisi">@Localizer["Analisi"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/GestioneAtleti">@Localizer["Gestione rosa"]</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/GestioneParametri">@Localizer["Parametri"]</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <!-- PULSANTE INSTALLAZIONE PWA (Nuovo colore) -->
                        <li class="nav-item d-flex align-items-center me-3 d-none" id="installContainer">
                            <button id="btnInstall" class="btn btn-outline-onus btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-download me-1"></i> Installa App
                            </button>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item d-flex align-items-center gap-2">
                                <button class="btn btn-dark border-secondary btn-sm rounded-pill px-3" data-bs-toggle="offcanvas" data-bs-target="#userSidebar">
                                    <i class="bi bi-person-circle me-1" style="color: #71d92d;"></i> @(Context.Session.GetString("NomeCompleto") ?? "User")
                                </button>
                                <a class="btn btn-onus btn-sm rounded-pill px-3" asp-page="/Login">@Localizer["ESCI"]</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a href="/Login" class="nav-link fw-bold text-white">@Localizer["Login"]</a></li>
                            <li class="nav-item"><a class="btn btn-onus btn-sm ms-2 rounded-pill" asp-page="/Registrazione">REGISTRAZIONE</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (Context.Session.GetInt32("UserId") != null)
    {
        <div class="offcanvas offcanvas-end bg-dark text-white border-start border-secondary" tabindex="-1" id="userSidebar">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title fw-bold text-uppercase text-danger">
                    <i class="bi bi-person-gear me-2"></i>@Localizer["Il Tuo Profilo"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
                <div class="text-center mb-4">
                    <div class="display-1 text-secondary">
                        <i class="bi bi-person-bounding-box"></i>
                    </div>
                    <h4 class="mt-3 fw-bold">@Context.Session.GetString("NomeCompleto")</h4>
                    <span class="badge bg-danger text-uppercase">@Context.Session.GetString("Ruolo")</span>
                </div>

                <form method="post" asp-page="/Profilo" asp-page-handler="SalvaDati">

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small text-uppercase">@Localizer["Nome"]</label>
                            <input type="text" name="Nome" class="form-control bg-black text-white border-secondary" value="@Context.Session.GetString("Nome")" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small text-uppercase">@Localizer["Cognome"]</label>
                            <input type="text" name="Cognome" class="form-control bg-black text-white border-secondary" value="@Context.Session.GetString("Cognome")" required>
                        </div>
                    </div>

                    @if (Context.Session.GetString("Ruolo") != "Staff")
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-warning small text-uppercase fw-bold">Altezza (cm)</label>
                                <input type="number" name="Altezza" class="form-control bg-black text-white border-warning" value="@Context.Session.GetInt32("Altezza")">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-warning small text-uppercase fw-bold">Peso (kg)</label>
                                <input type="number" step="0.1" name="Peso" class="form-control bg-black text-white border-warning" value="@Context.Session.GetString("Peso")">
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 mb-2" onclick="toggleCambioPassword()">
                            <i class="bi bi-key me-1"></i> @Localizer["Modifica Password"]
                        </button>
                        <div id="boxNuovaPass" style="display: none;">
                            <input type="password" name="NuovaPassword" class="form-control bg-black text-white border-warning" placeholder="Nuova password">
                        </div>
                    </div>

                    <hr class="border-secondary my-4">

                    <div class="mb-4">
                        <label class="form-label text-muted small text-uppercase">@Localizer["Lingua"]</label>
                        <div class="d-flex gap-2">
                            @{
                                var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
                                var currentCulture = requestCultureFeature?.RequestCulture.UICulture.Name ?? "it";
                                var isItalian = currentCulture.StartsWith("it");
                            }
                            <button type="submit" asp-page="/Profilo" asp-page-handler="CambiaLingua" asp-route-culture="it" formnovalidate
                                    class="btn flex-grow-1 @(isItalian ? "btn-light" : "btn-outline-secondary text-white")">
                                🇮🇹 ITA
                            </button>
                            <button type="submit" asp-page="/Profilo" asp-page-handler="CambiaLingua" asp-route-culture="en" formnovalidate
                                    class="btn flex-grow-1 @(!isItalian ? "btn-light" : "btn-outline-secondary text-white")">
                                🇬🇧 ENG
                            </button>
                        </div>
                    </div>

                    <div class="mb-3 bg-danger bg-opacity-10 p-3 rounded border border-danger border-opacity-25">
                        <label class="form-label text-white small text-uppercase fw-bold">@Localizer["Password Attuale"]</label>
                        <input type="password" name="PasswordAttuale" class="form-control bg-black text-white border-0 text-center" placeholder="Conferma per salvare" required>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold shadow">@Localizer["SALVA MODIFICHE"]</button>
                </form>
            </div>
        </div>
    }

    <!-- Modale Istruzioni Installazione iOS -->
    <div class="modal fade" id="iosInstallModal" tabindex="-1" aria-labelledby="iosInstallModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning fw-bold" id="iosInstallModalLabel">
                        <i class="bi bi-apple me-2"></i>Installa su iOS
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <p class="mb-4">Per installare <strong>ONUS</strong> sul tuo iPhone o iPad e usarla come un'app nativa, segui questi passaggi:</p>

                    <div class="text-start d-inline-block">
                        <p class="mb-3">
                            <strong>1.</strong> Tocca il tasto <strong>Condividi</strong> <i class="bi bi-box-arrow-up fs-4 text-info align-middle mx-1"></i> nella barra di Safari (in basso o in alto).
                        </p>
                        <p class="mb-0">
                            <strong>2.</strong> Scorri il menu in basso e tocca <strong>"Aggiungi alla schermata Home"</strong> <i class="bi bi-plus-square fs-5 text-light align-middle mx-1"></i>.
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary w-100 fw-bold" data-bs-dismiss="modal">Ho capito</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer text-muted text-center py-3 mt-5">
        <div class="container small">
            &copy; 2026 - ONUS Project - <a asp-page="/Privacy" class="text-secondary text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // 1. Nascondi il loader quando la pagina ha finito di caricare
        window.addEventListener('load', function () {
        document.getElementById('loading-overlay').classList.add('loaded');
        });

        // 2. Registrazione del Service Worker per la PWA
        if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js')
        .then(reg => console.log('PWA: Service Worker Registrato'))
        .catch(err => console.log('PWA: Errore SW', err));
        });
        }

        // 3. Funzione per mostrare/nascondere il box del cambio password
        function toggleCambioPassword() {
        var box = document.getElementById('boxNuovaPass');
        box.style.display = (box.style.display === 'none') ? 'block' : 'none';
        }

        // 4. LOGICA DI INSTALLAZIONE PWA (AGGIORNATA PER IOS E ANDROID)
        let deferredPrompt = null;
        const installContainer = document.getElementById('installContainer');
        const btnInstall = document.getElementById('btnInstall');

        // Funzione per capire se l'utente usa un dispositivo Apple (iOS)
        const isIos = () => {
        const userAgent = window.navigator.userAgent.toLowerCase();
        return /iphone|ipad|ipod/.test(userAgent);
        };

        // Funzione per capire se l'app è già installata (Standalone mode)
        const isInStandaloneMode = () => ('standalone' in window.navigator) && (window.navigator.standalone) || window.matchMedia('(display-mode: standalone)').matches;

        // Se è un iOS e l'app NON è installata, forziamo la comparsa del bottone
        if (isIos() && !isInStandaloneMode()) {
        installContainer.classList.remove('d-none');
        }

        // Cattura l'evento standard (per Android e Desktop)
        window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        installContainer.classList.remove('d-none'); // Mostra il bottone
        });

        // Cosa succede quando si clicca il bottone
        btnInstall.addEventListener('click', async () => {
        if (deferredPrompt !== null) {
        // Procedura standard PC/Android: mostra il prompt del browser
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
        console.log('PWA installata tramite prompt');
        }
        deferredPrompt = null;
        installContainer.classList.add('d-none');
        } else if (isIos() && !isInStandaloneMode()) {
        // Procedura iOS: Apri il nostro modale con le istruzioni manuali
        var iosModal = new bootstrap.Modal(document.getElementById('iosInstallModal'));
        iosModal.show();
        }
        });

        // Nascondi il bottone se il sistema ci avvisa che l'installazione è andata a buon fine
        window.addEventListener('appinstalled', () => {
        installContainer.classList.add('d-none');
        deferredPrompt = null;
        console.log('Installazione completata!');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>