@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<style>
    /* --- STILI PER LA HERO SECTION E IMMAGINI --- */
    .hero-section {
        background-image: url('/Images/8.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
        /* TRUCCO PER ALLARGARE LO SFONDO A TUTTA PAGINA */
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        /* Padding inferiore della sezione */
        padding-bottom: 3rem;
    }

        /* Overlay scuro per migliorare la leggibilità del testo */
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background-color: rgba(17, 17, 17, 0.6);
            z-index: 0;
        }

    .hero-image-wrapper {
        position: relative;
        width: 75%;
        margin: 0 auto;
        /* USIAMO IL MARGINE: allunga lo sfondo senza rompere la sovrapposizione! */
        margin-bottom: 15%;
    }

    .img-main {
        width: 100%;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        display: block; /* Elimina spazi vuoti indesiderati sotto l'immagine */
        position: relative;
        z-index: 1;
    }

    .img-overlay {
        width: 60%;
        position: absolute;
        /* Valore negativo spinge l'immagine in basso rispetto a quella principale */
        bottom: -15%;
        right: -15%;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.7);
        border: 4px solid #1a1a1a; /* Bordo scuro per staccarla dalla prima */
        z-index: 2;
    }

    /* --- STILI ORIGINALI --- */
    .hero-title {
        font-size: 4rem;
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -1px;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 300;
    }

    .feature-card {
        background: linear-gradient(145deg, #1a1a1a 0%, #111 100%);
        border: 1px solid #333;
        border-radius: 15px;
        padding: 2rem;
        height: 100%;
        transition: all 0.3s ease;
    }

        .feature-card:hover {
            border-color: var(--onus-blue);
            box-shadow: 0 10px 30px rgba(0, 160, 255, 0.1);
        }

    .feature-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background-color: rgba(0, 160, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

        .feature-icon-wrapper i {
            font-size: 1.8rem;
            color: var(--onus-blue);
        }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }

        .img-overlay {
            right: -5%;
        }
    }

    /* --- STILI PER LA SEZIONE WHY ONUS --- */
    .why-section {
        background-image: url('/Images/11.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: relative;
        /* Espande lo sfondo a tutta larghezza */
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        /* Padding ridotto per mantenere l'altezza più bassa rispetto alla prima sezione */
        padding: 3rem 0;
    }

        .why-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background-color: rgba(17, 17, 17, 0.75); /* Oscura leggermente lo sfondo per far leggere il testo */
            z-index: 0;
        }

    .why-content {
        position: relative;
        z-index: 1;
    }

    /* Regola l'immagine logo nel titolo per farla leggermente più grande */
    .title-logo-inline {
        height: 1.6em;
        width: auto;
        vertical-align: middle;
        margin-top: -8px;
    }

    .feature-card-compact {
        background: linear-gradient(145deg, rgba(26, 26, 26, 0.8) 0%, rgba(17, 17, 17, 0.8) 100%);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 1.5rem;
        height: 100%;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px); /* Leggero effetto sfocato se lo sfondo è visibile */
    }

        .feature-card-compact:hover {
            border-color: var(--onus-blue);
            transform: translateY(-5px);
        }

    /* --- STILI PER LO SFONDO CONDIVISO (SEZIONI 3 E 4) --- */
    .philosophy-shared-bg {
        background-image: url('/Images/13.png');
        background-size: cover;
        background-position: top center;
        background-repeat: no-repeat;
        position: relative;
        /* Espande lo sfondo a tutta larghezza */
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        padding-top: 5rem;
        padding-bottom: 5rem; /* Questo farà spazio anche alla sez. 4 in futuro */
    }

        .philosophy-shared-bg::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background-color: rgba(17, 17, 17, 0.85); /* Overlay per far leggere il testo */
            z-index: 0;
        }

    .philosophy-content {
        position: relative;
        z-index: 1;
    }

    /* --- STILI PER IL TESTO PHILOSOPHY --- */
    .philosophy-list {
        list-style: none;
        padding-left: 0;
        text-align: left;
        display: inline-block; /* Per centrarla nel div genitore */
    }

        .philosophy-list li {
            position: relative;
            padding-left: 1.5rem;
            margin-bottom: 0.8rem;
            color: rgba(255, 255, 255, 0.8);
            font-size: 1.1rem;
        }

            .philosophy-list li::before {
                content: '-';
                position: absolute;
                left: 0;
                color: var(--onus-blue);
                font-weight: bold;
            }

    /* --- STILI PER LA TIMELINE --- */
    .custom-timeline-wrapper {
        position: relative;
        padding: 1rem 0;
    }

    /* La linea di collegamento blu (Tratteggiata) */
    .custom-timeline-line {
        position: absolute;
        top: 90px;
        left: 16%;
        width: 67%; /* Leggermente accorciata visto che non c'è più la freccia */
        height: 0;
        border-top: 4px dashed var(--onus-blue);
        z-index: 1;
    }

    .timeline-dot {
        display: block;
        width: 26px; /* Leggermente più grande per compensare il bordo spesso */
        height: 26px;
        background: var(--onus-green);
        border-radius: 50%;
        border: 8px solid #181818; /* Bordo spesso e scuro che funge da 'gomma' per cancellare il tratteggio sotto */
        margin: 0 auto 20px auto;
        position: relative;
        z-index: 2; /* Obbliga il pallino a stare in primo piano sopra la linea */
    }

    .timeline-img {
        display: block;
        height: 60px;
        object-fit: contain;
        margin: 0 auto 20px auto;
        position: relative;
        z-index: 2;
    }

    .img-timeline-bottom {
        width: 100%;
        max-height: 280px;
        object-fit: contain;
    }
</style>

<!-- PRIMA PARTE CON SFONDO 8.png -->
<section class="hero-section">
    <div class="container pt-5 pb-5 mt-md-4 position-relative" style="z-index: 1;">
        <div class="row align-items-center g-5">
            <!-- Colonna Testo Sinistra -->
            <div class="col-lg-6">
                <h1 class="hero-title text-white mb-4">
                    WORK SMARTER.<br />
                    <span class="text-gradient-onus">TRAIN BETTER.</span><br />
                    BUILD LEGACY.
                </h1>

                <p class="fs-4 fw-bold text-white mb-1">
                    You’re probably doing a great job with athletes…
                </p>
                <p class="fs-4 fw-bold text-white mb-4">
                    ALREADY.
                </p>

                <div class="hero-subtitle mb-5">
                    <p class="mb-3 text-white">We create ONUS to help you reach higher standards without wasting time and costly resources.</p>
                    <p class="mb-0 text-white">ONUS is a simplifier, just this.<br />No tricks, no thoughts, just a smart companion for your career.</p>
                </div>

                <div class="d-flex gap-3 flex-wrap">
                    <a class="btn btn-onus btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg text-uppercase" style="letter-spacing: 1px;" href="/Login">
                        Login <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a class="btn btn-outline-light btn-lg px-5 py-3 fw-bold rounded-pill text-uppercase" style="letter-spacing: 1px;" href="/Registrazione">
                        Register
                    </a>
                </div>
            </div>

            <!-- Colonna Immagini Destra -->
            <div class="col-lg-6 mt-5 mt-lg-0">
                <div class="hero-image-wrapper">
                    <!-- Immagine Principale -->
                    <img src="/Images/18.png" alt="ONUS Dashboard" class="img-main" />
                    <!-- Immagine Sovrapposta (Basso a destra) -->
                    <img src="/Images/24.png" alt="ONUS Feature" class="img-overlay" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECONDA PARTE: WHY ONUS -->
<section class="why-section mt-5 border-top border-secondary">
    <div class="container why-content">
        <div class="text-center mb-5">
            <!-- Titolo con immagine logo ingrandita -->
            <h2 class="display-5 fw-bold text-white mb-2 d-flex align-items-center justify-content-center gap-3">
                Why <img src="/Images/5.png" alt="ONUS Logo" class="title-logo-inline" />
            </h2>
            <div style="width: 60px; height: 4px; background: var(--onus-blue); margin: 0 auto; border-radius: 2px;"></div>
        </div>

        <div class="row g-4">
            <!-- Colonna 1 -->
            <div class="col-lg-3 col-md-6">
                <div class="feature-card-compact">
                    <h5 class="text-gradient-onus fw-bold mb-3">EVIDENCE BASED</h5>
                    <p class="text-white-50 small mb-0" style="line-height: 1.6;">
                        Our 3 main metrics are based on thousand of validated scientific studies.<br><br>
                        All you need to do is to set up your team once you purchase ONUS and start to collect the data.
                    </p>
                </div>
            </div>

            <!-- Colonna 2 -->
            <div class="col-lg-3 col-md-6">
                <div class="feature-card-compact">
                    <h5 class="text-gradient-onus fw-bold mb-3">SMART NOTIFICATION</h5>
                    <p class="text-white-50 small mb-0" style="line-height: 1.6;">
                        Make it easy.<br>
                        With ONUS you can quickly send a notification to your team and let them open their dashboard to insert the individual data of the practice.<br><br>
                        "READ, CLICK, CHOOSE, SAVE".
                    </p>
                </div>
            </div>

            <!-- Colonna 3 -->
            <div class="col-lg-3 col-md-6">
                <div class="feature-card-compact">
                    <h5 class="text-gradient-onus fw-bold mb-3">USER FRIENDLY</h5>
                    <p class="text-white-50 small mb-0" style="line-height: 1.6;">
                        ONUS is planned to be simple.<br><br>
                        Once you get inside the app and set up your team, you just have to check the numbers and analyze the trend.
                    </p>
                </div>
            </div>

            <!-- Colonna 4 -->
            <div class="col-lg-3 col-md-6">
                <div class="feature-card-compact">
                    <h5 class="text-gradient-onus fw-bold mb-3">QUICK REPORT</h5>
                    <p class="text-white-50 small mb-0" style="line-height: 1.6;">
                        Sharing useful data among the coaching staff could be an issue sometimes.<br><br>
                        With ONUS you can easily choose what you want to export, and download the report in pdf.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TERZA PARTE: OUR PHILOSOPHY (Sfondo Condiviso) -->
<div class="philosophy-shared-bg mt-5 border-top border-secondary">
    <div class="container philosophy-content">

        <!-- Intestazione e Testo -->
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-white mb-4">- Our Philosophy -</h2>
            <div style="width: 60px; height: 4px; background: var(--onus-blue); margin: 0 auto 3rem auto; border-radius: 2px;"></div>

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <p class="fs-5 text-white mb-4">
                        We’ve been working in strength and conditioning field since many years now, and we constantly facing the <span class="text-gradient-onus fw-bold">“DATA CHALLENGE”</span>.
                    </p>
                    <ul class="philosophy-list">
                        <li>How many metrics should I track?</li>
                        <li>How do I track daily and long term?</li>
                        <li>How much technology do i need?</li>
                        <li>How easy in to collect the numbers?</li>
                        <li>How can I involve into the decision process the coaching staff?</li>
                        <li>How can I involve my athletes in the process without wasting their time?</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Blocco Grafico: 30.png + Timeline + 2.png -->
        <div class="row g-5 mt-4">
            <!-- Immagine 30.png a sinistra -->
            <div class="col-lg-4 d-flex">
                <img src="/Images/30.png" alt="Data Challenge" class="img-fluid rounded-4 shadow-lg w-100" style="object-fit: cover;" />
            </div>

            <!-- Colonna Timeline a destra -->
            <div class="col-lg-8 d-flex flex-column justify-content-between">

                <!-- La Timeline -->
                <div class="custom-timeline-wrapper">
                    <!-- Linea connettiva in background -->
                    <div class="custom-timeline-line d-none d-md-block"></div>

                    <div class="row text-center position-relative" style="z-index: 2;">
                        <!-- Punto 1 -->
                        <div class="col-md-4 mb-4 mb-md-0">
                            <img src="/Images/MEDIA.PNG" alt="Define Metrics" class="timeline-img" />
                            <div class="timeline-dot"></div>
                            <h6 class="text-gradient-onus fw-bold">1- DEFINE METRICS</h6>
                        </div>
                        <!-- Punto 2 -->
                        <div class="col-md-4 mb-4 mb-md-0">
                            <img src="/Images/HEARTHRATE.PNG" alt="Data Collection" class="timeline-img" />
                            <div class="timeline-dot"></div>
                            <h6 class="text-gradient-onus fw-bold">2- DATA COLLECTION</h6>
                        </div>
                        <!-- Punto 3 -->
                        <div class="col-md-4">
                            <img src="/Images/COACH.PNG" alt="Report & Sharing" class="timeline-img" />
                            <div class="timeline-dot"></div>
                            <h6 class="text-gradient-onus fw-bold">3 -REPORT & SHARING</h6>
                        </div>
                    </div>
                </div>

                <!-- Immagine 2.png in basso -->
                <div class="text-center mt-4 mt-md-auto">
                    <img src="/Images/2.png" alt="Process Output" class="img-timeline-bottom" />
                </div>

            </div>
        </div>

        <!-- QUI DENTRO INSERIREMO LA SEZIONE 4 IN FUTURO -->

    </div>
</div>