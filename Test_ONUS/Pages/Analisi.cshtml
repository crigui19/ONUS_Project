@page
@model Test_ONUS.Pages.AnalisiModel
@{
    ViewData["Title"] = "Analisi Dati";
}

<div class="container py-4">
    <h2 class="mb-4 text-white fw-bold text-uppercase tracking-wide border-start border-4 border-danger ps-3">
        @(Model.IsStaff ? "Analisi Prestazione" : "Il Mio Andamento")
    </h2>

    @if (Model.IsStaff)
    {
        <div class="card mb-4 border-0 shadow-lg" style="background: #2c2c2c;">
            <div class="card-body p-3">
                <form method="get" class="row align-items-center g-3">
                    <div class="col-auto"><label class="fw-bold text-white">Atleta:</label></div>
                    <div class="col-md-4">
                        <select name="atletaId" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                            <option value="">-- Scegli un giocatore --</option>
                            @foreach (var a in Model.Atleti)
                            {
                                <option value="@a.Id" selected="@(Model.NomeAtletaSelezionato.Contains(a.Nome) ? "selected" : null)">
                                    @a.Nome @a.Cognome
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-auto ms-auto"><label class="fw-bold text-white">Filtro Tempo:</label></div>
                    <div class="col-md-4">
                        <select name="filtroTempo" class="form-select bg-dark text-white border-warning" onchange="this.form.submit()">
                            <option value="tutto" selected="@(Request.Query["filtroTempo"] == "tutto" || string.IsNullOrEmpty(Request.Query["filtroTempo"]) ? "selected" : null)">Intera Stagione</option>
                            <option value="ultimi7" selected="@(Request.Query["filtroTempo"] == "ultimi7" ? "selected" : null)">Ultimi 7 allenamenti</option>
                            <option value="ultimaSettimana" selected="@(Request.Query["filtroTempo"] == "ultimaSettimana" ? "selected" : null)">Ultima settimana</option>
                            <option value="meseCorrente" selected="@(Request.Query["filtroTempo"] == "meseCorrente" ? "selected" : null)">Mese corrente</option>
                        </select>
                    </div>
                    <div class="col-auto ms-3 border-start border-secondary ps-4">
                        <a asp-page="/Report" class="btn btn-success fw-bold shadow-sm">
                            📄 CREA REPORT
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.NomeAtletaSelezionato))
    {
        <div class="d-flex align-items-center mb-4">
            <div>
                <h3 class="text-white m-0">@Model.NomeAtletaSelezionato</h3>
                <div class="mt-1">
                    <span class="badge bg-dark border border-secondary text-secondary me-2">
                        <i class="bi bi-rulers"></i> @Model.AltezzaAtleta cm
                    </span>
                    <span class="badge bg-dark border border-secondary text-secondary">
                        <i class="bi bi-speedometer2"></i> @Model.PesoAtleta kg
                    </span>
                    @if (Model.AltezzaAtleta > 0)
                    {
                        var bmi = Math.Round(Model.PesoAtleta / Math.Pow(Model.AltezzaAtleta / 100.0, 2), 1);
                        <span class="text-white-50 small"><i class="bi bi-activity text-danger"></i> BMI: @bmi</span>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-lg chart-container">
                    <div class="card-body">
                        <canvas id="graficoACWR" style="max-height: 350px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card h-100 border-0 shadow-lg acwr-box d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <h6 class="text-white-50 text-uppercase ls-1 mb-2">Ratio Acuto : Cronico</h6>
                        <h1 class="display-3 fw-bold text-white m-0">@Model.DatiACWR.LastOrDefault()</h1>
                        @{
                            double acwr = Model.DatiACWR.LastOrDefault();
                            string statusClass = (acwr >= 0.8 && acwr <= 1.3) ? "bg-success" : "bg-warning text-dark";
                            string statusText = (acwr >= 0.8 && acwr <= 1.3) ? "OPTIMAL" : "ATTENZIONE";
                        }
                        <div class="mt-3">
                            <span class="badge @statusClass px-4 py-2 rounded-pill fw-bold shadow-sm">@statusText</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card h-100 border-0 shadow-lg d-flex align-items-center justify-content-center" style="background: #1a1a1a; border-left: 4px solid #0d6efd !important;">
                    <div class="text-center p-3">
                        <h6 class="text-primary text-uppercase ls-1 mb-2">Weekly Player Load</h6>
                        <h1 class="display-3 fw-bold text-white m-0">@Model.CaricoSettimanale</h1>
                        <div class="mt-3">
                            <span class="text-muted small">Somma ultimi 7 gg</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="mb-3 text-white border-bottom border-secondary pb-2">Storico Sessioni</h4>
        <div class="card border-0 shadow-lg overflow-hidden mb-5">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle m-0">
                    <thead>
                        <tr class="text-uppercase text-muted small ls-1">
                            <th class="py-3 ps-4">Data</th>
                            <th class="text-center">Durata Tot.</th>
                            <th class="text-center">Tempo Eff.</th>
                            <th class="text-center">Carico</th>
                            <th class="">Dati Monitorati</th>
                            <th style="width: 25%;">Note</th>
                            <th class="text-end pe-4">Modifica</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.SessioniAtleta)
                        {
                            var valRpe = s.Valori.FirstOrDefault(v => v.Parametro.IsCalcoloCarico)?.Valore ?? 0;
                            var valSonno = s.Valori.FirstOrDefault(v => v.Parametro.Nome.Contains("Sonno"))?.Valore ?? 0;
                            var valDolore = s.Valori.FirstOrDefault(v => v.Parametro.Nome.Contains("Dolore") || v.Parametro.Nome.Contains("Indolenzimento"))?.Valore ?? 0;

                            <tr>
                                <td class="ps-4 fw-bold text-white">
                                    @s.Data.ToString("dd/MM/yy")
                                    <small class="badge bg-secondary">@s.Data.ToString("HH:mm")</small>
                                </td>
                                
                                <td class="text-center"><span class="badge bg-secondary">@s.DurataTotaleMinuti'</span></td>
                                <td class="text-center"><span class="badge bg-info text-dark">@s.TempoEffettivoMinuti'</span></td>
                                <td class="text-center fw-bold text-primary">@s.CaricoCalcolato</td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var val in s.Valori)
                                        {
                                            <div class="d-flex align-items-center bg-black bg-opacity-25 border border-secondary rounded px-2 py-1">
                                                <small class="text-uppercase me-2" style="font-size: 0.7em; letter-spacing: 0.5px;">
                                                    @val.Parametro.Nome
                                                </small>
                                                <span class="fw-bold text-white">@val.Valore</span>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td class="small text-truncate" style="max-width: 150px;">
                                    @(string.IsNullOrEmpty(s.Note) ? "-" : s.Note)
                                </td>
                                
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-warning border-0"
                                            onclick="apriModificaSessione(@s.Id, '@s.Data.ToString("yyyy-MM-ddTHH:mm")', @s.DurataTotaleMinuti, @s.TempoEffettivoMinuti, @valRpe, @valSonno, @valDolore, '@Html.Raw(s.Note?.Replace("'", "\\'"))')">
                                        ✏️ EDIT
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade" id="sessionModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-dark border border-secondary text-white shadow-lg">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title fw-bold text-warning">Modifica Sessione</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form method="post" asp-page-handler="UpdateSession">
                            <input type="hidden" id="editSessionId" name="sessionId" />

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Data e Ora</label>
                                    <input type="datetime-local" id="editData" name="data" class="form-control bg-secondary text-white border-0" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Durata Totale (min)</label>
                                    <input type="number" id="editDurataTotale" name="durataTotale" class="form-control bg-secondary text-white border-0" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Tempo Effettivo (min)</label>
                                    <input type="number" id="editTempoEffettivo" name="tempoEffettivo" class="form-control bg-secondary text-white border-0" required />
                                </div>

                                <div class="col-4">
                                    <label class="form-label text-muted small">RPE (0-10)</label>
                                    <input type="number" id="editRpe" name="rpe" min="0" max="10" class="form-control bg-secondary text-white border-0 fw-bold text-center" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label text-muted small">Sonno</label>
                                    <input type="number" id="editSonno" name="sonno" min="0" max="10" class="form-control bg-secondary text-white border-0 text-center" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label text-muted small">Dolore</label>
                                    <input type="number" id="editDolore" name="dolore" min="0" max="10" class="form-control bg-secondary text-white border-0 text-center" required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label text-muted small">Note</label>
                                    <textarea id="editNote" name="note" class="form-control bg-secondary text-white border-0" rows="3"></textarea>
                                </div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-warning fw-bold">SALVA MODIFICHE</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                // Funzione per popolare il modale
                function apriModificaSessione(id, dataStr, durataTotale, tempoEffettivo, rpe, sonno, dolore, note) {
                document.getElementById('editSessionId').value = id;
                document.getElementById('editData').value = dataStr;
                document.getElementById('editDurataTotale').value = durataTotale;
                document.getElementById('editTempoEffettivo').value = tempoEffettivo;
                document.getElementById('editRpe').value = rpe;
                document.getElementById('editSonno').value = sonno;
                document.getElementById('editDolore').value = dolore;
                document.getElementById('editNote').value = note;

                new bootstrap.Modal(document.getElementById('sessionModal')).show();
                }

                document.addEventListener("DOMContentLoaded", function() {
                const canvas = document.getElementById('graficoACWR');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');

                const labels = @Html.Raw(Json.Serialize(Model.EtichetteDate));
                const dataAcute = @Html.Raw(Json.Serialize(Model.DatiAcute));
                const dataChronic = @Html.Raw(Json.Serialize(Model.DatiChronic));
                const dataZScore = @Html.Raw(Json.Serialize(Model.DatiZScore));

                let gradientAcute = ctx.createLinearGradient(0, 0, 0, 400);
                gradientAcute.addColorStop(0, 'rgba(255, 71, 87, 0.4)');
                gradientAcute.addColorStop(1, 'rgba(255, 71, 87, 0)');

                Chart.defaults.color = '#a0a0a0';
                Chart.defaults.borderColor = '#444';

                new Chart(ctx, {
                type: 'line',
                data: {
                labels: labels,
                datasets: [
                {
                label: 'Acute Load (7gg)',
                data: dataAcute,
                borderColor: '#ff4757',
                backgroundColor: gradientAcute,
                borderWidth: 3,
                pointBackgroundColor: '#ff4757',
                pointRadius: 4,
                tension: 0.4,
                fill: true,
                yAxisID: 'y'
                },
                {
                label: 'Chronic Load (28gg)',
                data: dataChronic,
                borderColor: '#3742fa',
                backgroundColor: 'rgba(55, 66, 250, 0.1)',
                borderWidth: 2,
                pointRadius: 0,
                borderDash: [5, 5],
                tension: 0.4,
                fill: true,
                yAxisID: 'y'
                },
                {
                label: 'Z-Score (Load)',
                data: dataZScore,
                borderColor: '#f1c40f',
                borderWidth: 2,
                pointBackgroundColor: '#f1c40f',
                pointRadius: 3,
                borderDash: [2, 2],
                tension: 0.2,
                fill: false,
                yAxisID: 'y1'
                }
                ]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                y: {
                beginAtZero: true,
                position: 'left',
                grid: { color: '#333' }
                },
                y1: {
                beginAtZero: false,
                position: 'right',
                grid: { display: false },
                suggestedMin: -3,
                suggestedMax: 3
                },
                x: { grid: { display: false } }
                }
                }
                });
                });
            </script>
        }
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="height: 50vh;">
            <h1 class="display-1 text-muted mb-3" style="opacity: 0.2;">📊</h1>
            <h3 class="text-white">Nessun atleta selezionato</h3>
        </div>
    }
</div>