@page
@model Test_ONUS.Pages.AnalisiModel
@{
    ViewData["Title"] = "Data Analysis";
}

<div class="container py-4">
    <h2 class="mb-4 text-white fw-bold text-uppercase tracking-wide border-start border-4 ps-3" style="border-color: var(--onus-green) !important;">
        @(Model.IsStaff ? "Performance Analysis" : "My Progress")
    </h2>

    @if (Model.IsStaff)
    {
        <div class="card mb-4 border-secondary shadow-lg bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2) !important;">
            <div class="card-body p-3">
                <form method="get" class="row align-items-center g-3">
                    <div class="col-auto"><label class="fw-bold text-white-50">Athlete:</label></div>
                    <div class="col-md-4">
                        <select name="atletaId" class="form-select bg-black text-white border-secondary shadow-sm" onchange="this.form.submit()">
                            <option value="">-- Choose a player --</option>
                            @foreach (var a in Model.Atleti)
                            {
                                <option value="@a.Id" selected="@(Model.NomeAtletaSelezionato.Contains(a.Nome) ? "selected" : null)">
                                    @a.Nome @a.Cognome
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-auto ms-auto"><label class="fw-bold text-white-50">Time Filter:</label></div>
                    <div class="col-md-4">
                        <select name="filtroTempo" class="form-select bg-black text-white shadow-sm" style="border-color: var(--onus-blue) !important;" onchange="this.form.submit()">
                            <option value="tutto" selected="@(Request.Query["filtroTempo"] == "tutto" || string.IsNullOrEmpty(Request.Query["filtroTempo"]) ? "selected" : null)">Entire Season</option>
                            <option value="ultimi7" selected="@(Request.Query["filtroTempo"] == "ultimi7" ? "selected" : null)">Last 7 workouts</option>
                            <option value="ultimaSettimana" selected="@(Request.Query["filtroTempo"] == "ultimaSettimana" ? "selected" : null)">Last week</option>
                            <option value="meseCorrente" selected="@(Request.Query["filtroTempo"] == "meseCorrente" ? "selected" : null)">Current month</option>
                        </select>
                    </div>
                    <div class="col-auto ms-3 border-start border-secondary ps-4">
                        <a asp-page="/Report" class="btn btn-outline-onus fw-bold shadow-sm rounded-pill px-3">
                            <i class="bi bi-file-earmark-pdf me-1"></i> CREATE REPORT
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.NomeAtletaSelezionato))
    {
        <div class="d-flex align-items-center mb-4">
            <div>
                <h3 class="text-gradient-onus m-0 fw-bold tracking-wide">@Model.NomeAtletaSelezionato</h3>
                <div class="mt-1">
                    <span class="badge bg-black border border-secondary text-white-50 me-2 py-2 px-3 rounded-pill shadow-sm">
                        <i class="bi bi-rulers text-info"></i> @Model.AltezzaAtleta cm
                    </span>
                    <span class="badge bg-black border border-secondary text-white-50 py-2 px-3 rounded-pill shadow-sm">
                        <i class="bi bi-speedometer2 text-info"></i> @Model.PesoAtleta kg
                    </span>
                    @if (Model.AltezzaAtleta > 0)
                    {
                        var bmi = Math.Round(Model.PesoAtleta / Math.Pow(Model.AltezzaAtleta / 100.0, 2), 1);
                        <span class="text-white-50 small ms-3"><i class="bi bi-activity" style="color: var(--onus-green);"></i> BMI: @bmi</span>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card h-100 shadow-lg chart-container bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2);">
                    <div class="card-body">
                        <canvas id="graficoACWR" style="max-height: 350px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card h-100 shadow-lg acwr-box d-flex align-items-center justify-content-center bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2);">
                    <div class="text-center p-3">
                        <h6 class="text-white-50 text-uppercase ls-1 mb-2">Acute : Chronic Ratio</h6>
                        <h1 class="display-3 fw-bold text-gradient-onus m-0">@Model.DatiACWR.LastOrDefault()</h1>
                        @{
                            double acwr = Model.DatiACWR.LastOrDefault();
                            string statusClass = (acwr >= 0.8 && acwr <= 1.3) ? "bg-black text-white border-onus" : "bg-black text-white border-danger";
                            string statusText = (acwr >= 0.8 && acwr <= 1.3) ? "OPTIMAL" : "WARNING";
                            string dotColor = (acwr >= 0.8 && acwr <= 1.3) ? "var(--onus-green)" : "#ff4757";
                        }
                        <div class="mt-3">
                            <span class="badge @statusClass px-4 py-2 rounded-pill fw-bold shadow-sm" style="border: 1px solid @dotColor;">
                                <span style="color: @dotColor; margin-right: 5px;">●</span> @statusText
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="card h-100 shadow-lg d-flex align-items-center justify-content-center bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2); border-left: 4px solid var(--onus-blue) !important;">
                    <div class="text-center p-3">
                        <h6 class="text-uppercase ls-1 mb-2" style="color: var(--onus-blue);">Weekly Player Load</h6>
                        <h1 class="display-3 fw-bold text-white m-0">@Model.CaricoSettimanale</h1>
                        <div class="mt-3">
                            <span class="badge bg-black border border-secondary text-white-50 rounded-pill px-3 py-2">Sum of last 7 days</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="mb-3 text-gradient-onus fw-bold tracking-wide border-bottom border-secondary pb-2">SESSION HISTORY</h4>
        <div class="card shadow-lg overflow-hidden mb-5 bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2);">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle m-0">
                    <thead>
                        <tr class="text-uppercase text-white-50 small ls-1" style="border-bottom: 2px solid var(--onus-blue);">
                            <th class="py-3 ps-4">Date</th>
                            <th class="text-center">Total Dur.</th>
                            <th class="text-center">Eff. Time</th>
                            <th class="text-center">Load</th>
                            <th class="">Monitored Data</th>
                            <th style="width: 25%;">Notes</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.SessioniAtleta)
                        {
                            var valRpe = s.Valori.FirstOrDefault(v => v.Parametro.IsCalcoloCarico)?.Valore ?? 0;
                            var valSonno = s.Valori.FirstOrDefault(v => v.Parametro.Nome.Contains("Sonno"))?.Valore ?? 0;
                            var valDolore = s.Valori.FirstOrDefault(v => v.Parametro.Nome.Contains("Dolore") || v.Parametro.Nome.Contains("Indolenzimento"))?.Valore ?? 0;

                            <tr style="border-bottom: 1px solid #333;">
                                <td class="ps-4 fw-bold text-white py-3">
                                    @s.Data.ToString("dd/MM/yy")
                                    <small class="badge bg-black border border-secondary ms-2 text-white-50">@s.Data.ToString("HH:mm")</small>
                                </td>

                                <td class="text-center"><span class="badge bg-black border border-secondary text-white">@s.DurataTotaleMinuti'</span></td>
                                <td class="text-center"><span class="badge bg-black text-white" style="border: 1px solid var(--onus-blue);">@s.TempoEffettivoMinuti'</span></td>
                                <td class="text-center fw-bold fs-5 text-gradient-onus">@s.CaricoCalcolato</td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var val in s.Valori)
                                        {
                                            <div class="d-flex align-items-center bg-black border border-secondary rounded-pill px-3 py-1 shadow-sm">
                                                <small class="text-uppercase me-2 text-white-50" style="font-size: 0.65em; letter-spacing: 0.5px;">
                                                    @val.Parametro.Nome
                                                </small>
                                                <span class="fw-bold" style="color: var(--onus-green);">@val.Valore</span>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td class="small text-white-50 fst-italic text-truncate" style="max-width: 150px;">
                                    @(string.IsNullOrEmpty(s.Note) ? "-" : s.Note)
                                </td>

                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-onus rounded-pill px-3 shadow-sm"
                                            onclick="apriModificaSessione(@s.Id, '@s.Data.ToString("yyyy-MM-ddTHH:mm")', @s.DurataTotaleMinuti, @s.TempoEffettivoMinuti, @valRpe, @valSonno, @valDolore, '@Html.Raw(s.Note?.Replace("'", "\\'"))')">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Modale Modifica Sessione -->
        <div class="modal fade" id="sessionModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-dark text-white shadow-lg" style="border: 1px solid var(--onus-blue) !important;">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title fw-bold text-gradient-onus tracking-wide">EDIT SESSION</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <form method="post" asp-page-handler="UpdateSession">
                            <input type="hidden" id="editSessionId" name="sessionId" />

                            <div class="row g-3">
                                <div class="col-md-4 form-floating">
                                    <input type="datetime-local" id="editData" name="data" class="form-control bg-black text-white border-secondary shadow-sm" required />
                                    <label for="editData" class="text-white-50 ms-2">Date and Time</label>
                                </div>
                                <div class="col-md-4 form-floating">
                                    <input type="number" id="editDurataTotale" name="durataTotale" class="form-control bg-black text-white border-secondary shadow-sm" required />
                                    <label for="editDurataTotale" class="text-white-50 ms-2">Total Dur. (min)</label>
                                </div>
                                <div class="col-md-4 form-floating">
                                    <input type="number" id="editTempoEffettivo" name="tempoEffettivo" class="form-control bg-black text-white border-secondary shadow-sm" required />
                                    <label for="editTempoEffettivo" class="text-white-50 ms-2">Eff. Time (min)</label>
                                </div>

                                <div class="col-4 mt-4 text-center">
                                    <label class="form-label text-white-50 small text-uppercase">RPE (0-10)</label>
                                    <input type="number" id="editRpe" name="rpe" min="0" max="10" class="form-control bg-black text-white shadow-sm fw-bold text-center fs-4" style="border: 1px solid var(--onus-green);" required />
                                </div>
                                <div class="col-4 mt-4 text-center">
                                    <label class="form-label text-white-50 small text-uppercase">Sleep</label>
                                    <input type="number" id="editSonno" name="sonno" min="0" max="10" class="form-control bg-black text-white border-secondary shadow-sm text-center fs-4" required />
                                </div>
                                <div class="col-4 mt-4 text-center">
                                    <label class="form-label text-white-50 small text-uppercase">Pain</label>
                                    <input type="number" id="editDolore" name="dolore" min="0" max="10" class="form-control bg-black text-white border-secondary shadow-sm text-center fs-4" required />
                                </div>

                                <div class="col-12 mt-4">
                                    <label class="form-label text-white-50 small text-uppercase ms-1">Optional Notes</label>
                                    <textarea id="editNote" name="note" class="form-control bg-black text-white border-secondary shadow-sm" rows="3" placeholder="Add a note..."></textarea>
                                </div>
                            </div>

                            <div class="d-grid mt-4 pt-3 border-top border-secondary">
                                <button type="submit" class="btn btn-onus rounded-pill py-3 fw-bold shadow-lg">SAVE CHANGES <i class="bi bi-check2-circle ms-1"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                function apriModificaSessione(id, dataStr, durataTotale, tempoEffettivo, rpe, sonno, dolore, note) {
                document.getElementById('editSessionId').value = id;
                document.getElementById('editData').value = dataStr;
                document.getElementById('editDurataTotale').value = durataTotale;
                document.getElementById('editTempoEffettivo').value = tempoEffettivo;
                document.getElementById('editRpe').value = rpe;
                document.getElementById('editSonno').value = sonno;
                document.getElementById('editDolore').value = dolore;
                document.getElementById('editNote').value = note;

                new bootstrap.Modal(document.getElementById('sessionModal')).show();
                }

                document.addEventListener("DOMContentLoaded", function() {
                const canvas = document.getElementById('graficoACWR');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');

                const labels = @Html.Raw(Json.Serialize(Model.EtichetteDate));
                const dataAcute = @Html.Raw(Json.Serialize(Model.DatiAcute));
                const dataChronic = @Html.Raw(Json.Serialize(Model.DatiChronic));
                const dataZScore = @Html.Raw(Json.Serialize(Model.DatiZScore));

                // Aggiorniamo i colori del grafico con il nuovo verde fluo
                let gradientAcute = ctx.createLinearGradient(0, 0, 0, 400);
                gradientAcute.addColorStop(0, 'rgba(113, 217, 45, 0.5)'); // Verde ONUS con trasparenza
                gradientAcute.addColorStop(1, 'rgba(113, 217, 45, 0)');

                Chart.defaults.color = '#888';
                Chart.defaults.borderColor = '#333';

                new Chart(ctx, {
                type: 'line',
                data: {
                labels: labels,
                datasets: [
                {
                label: 'Acute Load (7 days)',
                data: dataAcute,
                borderColor: '#71d92d', // Verde ONUS
                backgroundColor: gradientAcute,
                borderWidth: 3,
                pointBackgroundColor: '#71d92d',
                pointRadius: 4,
                tension: 0.4,
                fill: true,
                yAxisID: 'y'
                },
                {
                label: 'Chronic Load (28 days)',
                data: dataChronic,
                borderColor: '#00a0ff', // Azzurro ONUS
                backgroundColor: 'rgba(0, 160, 255, 0.1)',
                borderWidth: 2,
                pointRadius: 0,
                borderDash: [5, 5],
                tension: 0.4,
                fill: true,
                yAxisID: 'y'
                },
                {
                label: 'Z-Score (Load)',
                data: dataZScore,
                borderColor: '#f1c40f', // Lasciamo il giallo per lo Z-Score
                borderWidth: 2,
                pointBackgroundColor: '#f1c40f',
                pointRadius: 3,
                borderDash: [2, 2],
                tension: 0.2,
                fill: false,
                yAxisID: 'y1'
                }
                ]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                y: {
                beginAtZero: true,
                position: 'left',
                grid: { color: '#2a2a2a' }
                },
                y1: {
                beginAtZero: false,
                position: 'right',
                grid: { display: false },
                suggestedMin: -3,
                suggestedMax: 3
                },
                x: { grid: { display: false } }
                }
                }
                });
                });
            </script>
        }
    }
    else
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="height: 50vh;">
            <div class="rounded-circle d-flex align-items-center justify-content-center mb-4 shadow" style="width: 120px; height: 120px; border: 2px dashed rgba(0, 160, 255, 0.4); background-color: #1a1a1a;">
                <i class="bi bi-bar-chart-line" style="font-size: 3rem; color: rgba(0, 160, 255, 0.5);"></i>
            </div>
            <h3 class="text-white fw-bold tracking-wide">No Athlete Selected</h3>
            <p class="text-white-50">Choose a player from the dropdown menu above to view their statistics.</p>
        </div>
    }
</div>
