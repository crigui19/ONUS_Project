@page
@model Test_ONUS.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Set New Password";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card bg-dark text-white p-4 text-center shadow-lg" style="width: 100%; max-width: 450px; border: 1px solid rgba(0, 160, 255, 0.3); box-shadow: 0 0 20px rgba(0, 160, 255, 0.1) !important;">

        <div class="mb-4">
            <h2 class="text-gradient-onus fw-bold m-0 tracking-wide">NEW PASSWORD</h2>
            <p class="text-white-50 mt-2 small">Enter your new secure password below.</p>
        </div>

        <form method="post">
            <!-- Token nascosto preso dall'URL -->
            <input type="hidden" asp-for="Token" />

            <div class="form-floating mb-3 text-start">
                <input asp-for="NuovaPassword" type="password" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="New Password" required />
                <label asp-for="NuovaPassword">New Password</label>
            </div>

            <div class="form-floating mb-4 text-start">
                <input asp-for="ConfermaPassword" type="password" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Confirm Password" required />
                <label asp-for="ConfermaPassword">Confirm Password</label>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert bg-danger bg-opacity-25 border border-danger text-white py-2 mb-3 shadow-sm text-start small">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>@Model.Message
                </div>
            }

            <button type="submit" class="btn btn-onus w-100 py-3 fw-bold fs-5 rounded-pill shadow-lg mt-2">
                SAVE NEW PASSWORD <i class="bi bi-check-circle ms-1"></i>
            </button>
        </form>
    </div>
</div>