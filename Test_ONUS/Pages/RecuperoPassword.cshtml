@page
@model Test_ONUS.Pages.RecuperoPasswordModel
@{
    ViewData["Title"] = "Password Recovery";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card bg-dark text-white p-4 text-center shadow-lg" style="width: 100%; max-width: 450px; border: 1px solid rgba(0, 160, 255, 0.3); box-shadow: 0 0 20px rgba(0, 160, 255, 0.1) !important;">

        <div class="mb-4">
            <h2 class="text-gradient-onus fw-bold m-0 tracking-wide">RECOVER PASSWORD</h2>
            <p class="text-white-50 mt-2 small">Enter your registration email. We will send you a secure link to reset your password.</p>
        </div>

        <form method="post">
            <div class="form-floating mb-4 text-start">
                <input asp-for="Email" type="email" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Email" required />
                <label asp-for="Email">Email Address</label>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert @(Model.IsSuccess ? "bg-success border-success" : "bg-danger border-danger") bg-opacity-25 text-white py-2 mb-3 shadow-sm text-start small">
                    @Model.Message
                </div>
            }

            <button type="submit" class="btn btn-onus w-100 py-3 fw-bold fs-5 rounded-pill shadow-lg mt-2">
                SEND RESET LINK <i class="bi bi-envelope-paper ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-4 border-top border-secondary pt-3">
            <a href="/Login" class="text-white-50 text-decoration-none small hover-white">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </div>
</div>