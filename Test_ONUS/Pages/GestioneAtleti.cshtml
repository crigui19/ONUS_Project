@page
@model Test_ONUS.Pages.GestioneAtletiModel
@{
    ViewData["Title"] = "Gestione Squadra";
}

<style>
    /* Stile per l'area di upload Drag & Drop aggiornato al nuovo brand */
    .upload-area {
        border: 2px dashed #6c757d;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        background-color: #1a1a1a;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .upload-area:hover, .upload-area.dragover {
            border-color: var(--onus-blue); /* Azzurro Accento */
            background-color: #222;
            box-shadow: 0 0 15px rgba(0, 160, 255, 0.2);
        }

        .upload-area input[type="file"] {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            opacity: 0;
            cursor: pointer;
        }

    .preview-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--onus-green);
        margin-bottom: 10px;
        display: none;
    }

    .icon-placeholder {
        font-size: 2rem;
        color: var(--onus-blue);
        margin-bottom: 5px;
    }
</style>

<div class="container mt-4">
    <div class="card bg-dark text-white mb-4 shadow" style="border: 1px solid rgba(0, 160, 255, 0.3);">
        <div class="card-body">
            <h4 class="card-title text-gradient-onus fw-bold tracking-wide mb-3">@Localizer["GESTIONE SQUADRA"]</h4>
            <form method="post" asp-page-handler="AggiornaSquadra" class="row g-3 align-items-center mt-2">
                <div class="col-auto">
                    <label class="col-form-label text-white-50">@Localizer["Nome Squadra"]:</label>
                </div>
                <div class="col-auto">
                    <input type="text" class="form-control bg-black text-white border-secondary shadow-sm" asp-for="NomeSquadra" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-onus rounded-pill px-4">@Localizer["Aggiorna Nome"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <h3 class="text-white fw-bold text-uppercase tracking-wide border-start border-4 ps-3 mb-0" style="border-color: var(--onus-green) !important;">
            Rosa Giocatori
        </h3>
        <div class="d-flex gap-3">
            <button type="button" class="btn btn-outline-onus rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#notificheModal">
                <i class="bi bi-bell-fill me-1"></i> Promemoria
            </button>
            <button class="btn btn-onus fw-bold shadow-lg rounded-pill px-4" onclick="apriModaleAtleta(0, '', '', '', '', true)">
                <i class="bi bi-person-plus-fill me-1"></i> NUOVO GIOCATORE
            </button>
        </div>
    </div>

    <div class="modal fade" id="notificheModal" tabindex="-1" aria-labelledby="notificheModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <form method="post" asp-page-handler="InviaNotifiche">
                    <div class="modal-header border-secondary" style="border-bottom: 1px solid rgba(0, 160, 255, 0.3);">
                        <h5 class="modal-title text-gradient-onus fw-bold" id="notificheModalLabel">Seleziona Atleti da Avvisare</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-white-50 small mb-4">Seleziona i giocatori a cui mandare il promemoria Push sui loro dispositivi:</p>

                        <div class="list-group mb-4 shadow-sm">
                            @if (Model.Atleti != null && Model.Atleti.Any())
                            {
                                @foreach (var atleta in Model.Atleti)
                                {
                                    <label class="list-group-item bg-black text-white border-secondary d-flex gap-3 align-items-center py-3" style="cursor: pointer;">
                                        <input class="form-check-input flex-shrink-0" type="checkbox" name="AtletiSelezionati" value="@atleta.Id" style="transform: scale(1.2);">
                                        <span class="fw-bold">
                                            @atleta.Nome @atleta.Cognome
                                        </span>
                                    </label>
                                }
                            }
                            else
                            {
                                <p class="text-muted fst-italic p-3 bg-black rounded">Nessun atleta trovato per questa squadra.</p>
                            }
                        </div>

                        <div>
                            <label for="messaggioNotifica" class="form-label fw-bold text-white-50">Messaggio della notifica:</label>
                            <textarea class="form-control bg-black text-white border-secondary shadow-sm" id="messaggioNotifica" name="MessaggioTesto" rows="2">Ciao! Ricordati di inserire i dati della sessione di oggi nell'app. Grazie!</textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-light rounded-pill" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-onus rounded-pill px-4 fw-bold">Invia Notifica <i class="bi bi-send ms-1"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-lg overflow-hidden bg-dark" style="border: 1px solid rgba(0, 160, 255, 0.2);">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle m-0">
                <thead>
                    <tr class="text-uppercase text-white-50 small ls-1" style="border-bottom: 2px solid var(--onus-blue);">
                        <th class="py-3 ps-4">Avatar</th>
                        <th>Nome & Cognome</th>
                        <th>Credenziali App</th>
                        <th class="text-center">Stato Fisico</th>
                        <th class="text-end pe-4">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var atleta in Model.Atleti)
                    {
                        <tr style="border-bottom: 1px solid #333;">
                            <td class="ps-4 py-3">
                                <img src="@atleta.FotoUrl" class="rounded-circle" width="50" height="50" style="object-fit: cover; border: 2px solid var(--onus-green);">
                            </td>
                            <td>
                                <h5 class="m-0 text-white fw-bold">@atleta.Nome @atleta.Cognome</h5>
                                <div class="text-white-50 small mt-1">
                                    <i class="bi bi-rulers text-info"></i> @atleta.Altezza cm <span class="mx-1">|</span>
                                    <i class="bi bi-speedometer2 text-info"></i> @atleta.Peso kg
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge bg-black border border-secondary text-white-50 w-auto align-self-start py-2 px-3 rounded-pill"><i class="bi bi-person me-1"></i> @atleta.Nome</span>
                                    <span class="badge bg-black border border-secondary text-white-50 w-auto align-self-start py-2 px-3 rounded-pill"><i class="bi bi-key me-1"></i> @(atleta.Password.StartsWith("$2") ? "***" : atleta.Password)</span>
                                </div>
                            </td>
                            <td class="text-center align-middle">
                                @if (!atleta.IsAttivo)
                                {
                                    <span class="badge bg-secondary p-2 shadow-sm rounded-pill px-3">INATTIVO</span>
                                }
                                else if (atleta.IsInfortunato)
                                {
                                    <span class="badge p-2 shadow-sm fw-bold tracking-wide rounded-pill px-3" style="background-color: #ff4757; color: white; letter-spacing: 1px;">INFORTUNATO</span>
                                }
                                else if (atleta.IsInRiabilitazione)
                                {
                                    <span class="badge text-dark p-2 shadow-sm fw-bold tracking-wide rounded-pill px-3" style="background-color: #ffa502; letter-spacing: 1px;">IN RIABILITAZIONE</span>
                                }
                                else
                                {
                                    <span class="badge p-2 shadow-sm fw-bold tracking-wide rounded-pill px-3" style="background-color: var(--onus-green); color: black; letter-spacing: 1px;">DISPONIBILE</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-onus rounded-pill me-2 px-3"
                                        onclick="apriModaleAtleta(@atleta.Id, '@atleta.Nome', '@atleta.Cognome', '', '@atleta.FotoUrl', @atleta.IsAttivo.ToString().ToLower(), @atleta.IsInfortunato.ToString().ToLower(), @atleta.IsInRiabilitazione.ToString().ToLower(), '@(atleta.DescrizioneInfortunio?.Replace("'", "\\'") ?? "")', @atleta.Altezza, @atleta.Peso)">
                                    <i class="bi bi-pencil-square me-1"></i> Modifica
                                </button>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@atleta.Id" class="d-inline" onsubmit="return confirm('Sei sicuro di voler eliminare definitivamente questo giocatore? L\'azione è irreversibile.');">
                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-2 lh-1"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="atletaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border text-white shadow-lg" style="border-color: var(--onus-blue) !important;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-gradient-onus" id="modalTitle">Gestione Giocatore</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                    <input type="hidden" id="atletaId" name="Id" value="0" />
                    <input type="hidden" id="fotoUrlCorrente" name="FotoUrlCorrente" />

                    <div class="row g-3">
                        <div class="col-12 mb-2">
                            <label class="form-label text-white-50 small text-uppercase">Foto Profilo</label>
                            <div class="upload-area" id="dropZone">
                                <input type="file" id="uploadImmagine" name="UploadImmagine" accept="image/*" onchange="mostraAnteprima(this)">

                                <div id="uploadTextContent">
                                    <div class="icon-placeholder"><i class="bi bi-camera"></i></div>
                                    <p class="m-0 text-white-50 small mt-2">Trascina qui l'immagine o clicca per caricare</p>
                                </div>

                                <img id="previewImg" class="preview-img mx-auto mt-2" src="" />
                            </div>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input type="text" id="nome" name="Nome" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Nome" required />
                            <label for="nome" class="text-white-50 ms-2">Nome</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input type="text" id="cognome" name="Cognome" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Cognome" required />
                            <label for="cognome" class="text-white-50 ms-2">Cognome</label>
                        </div>

                        <div class="col-md-6 form-floating">
                            <input type="number" id="altezza" name="Altezza" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Altezza" required />
                            <label for="altezza" class="text-white-50 ms-2">Altezza (cm)</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input type="number" step="0.1" id="peso" name="Peso" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Peso" required />
                            <label for="peso" class="text-white-50 ms-2">Peso (kg)</label>
                        </div>

                        <div class="col-md-12 form-floating mt-3">
                            <input type="password" id="password" name="Password" class="form-control bg-black text-white border-secondary shadow-sm" placeholder="Nuova Password" />
                            <label for="password" class="text-white-50 ms-2">Nuova Password (lascia vuoto per non modificare)</label>
                        </div>

                        <div class="col-md-12 mt-3">
                            <div class="form-check form-switch p-3 bg-black border border-secondary rounded shadow-sm d-flex align-items-center gap-3">
                                <input class="form-check-input mt-0" type="checkbox" id="isAttivo" name="IsAttivo" value="true" checked style="transform: scale(1.3);">
                                <label class="form-check-label text-white fw-bold mb-0" for="isAttivo">Giocatore Attivo nella Rosa</label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top border-secondary">
                            <h6 class="text-white-50 text-uppercase mb-3 ls-1 small">Stato Medico</h6>

                            <div class="d-flex gap-4 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isInfortunato" name="IsInfortunato" value="true" onchange="gestisciStatoFisico('infortunato')">
                                    <label class="form-check-label fw-bold" style="color: #ff4757;" for="isInfortunato">Infortunato</label>
                                </div>

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isInRiabilitazione" name="IsInRiabilitazione" value="true" onchange="gestisciStatoFisico('riabilitazione')">
                                    <label class="form-check-label fw-bold" style="color: #ffa502;" for="isInRiabilitazione">In Riabilitazione</label>
                                </div>
                            </div>

                            <div class="mt-2" id="boxDescrizioneInfortunio" style="display: none;">
                                <label class="form-label text-white-50 small">Descrizione Dettagliata (Visibile nella Dashboard)</label>
                                <textarea id="descrizioneInfortunio" name="DescrizioneInfortunio" class="form-control bg-black text-white border-secondary shadow-sm" rows="3" placeholder="Inserisci i dettagli dell'infortunio..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mt-4 pt-2">
                        <button type="submit" class="btn btn-onus rounded-pill py-3 fw-bold shadow-lg">SALVA GIOCATORE <i class="bi bi-check-lg ms-1"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Controlla se mostrare o nascondere le note
    function aggiornaVisibilitaNote() {
        const isInfortunato = document.getElementById('isInfortunato').checked;
        const isInRiabilitazione = document.getElementById('isInRiabilitazione').checked;
        const boxNote = document.getElementById('boxDescrizioneInfortunio');
        const txtNote = document.getElementById('descrizioneInfortunio');

        if (isInfortunato || isInRiabilitazione) {
            boxNote.style.display = 'block';
        } else {
            boxNote.style.display = 'none';
            txtNote.value = '';
        }
    }

    // 2. Toggle infortunio/riabilitazione esclusivo
    function gestisciStatoFisico(tipo) {
        const infortunato = document.getElementById('isInfortunato');
        const riabilitazione = document.getElementById('isInRiabilitazione');

        if (tipo === 'infortunato' && infortunato.checked) {
            riabilitazione.checked = false;
        } else if (tipo === 'riabilitazione' && riabilitazione.checked) {
            infortunato.checked = false;
        }

        aggiornaVisibilitaNote();
    }

    // 3. Drag & Drop
    const dropZone = document.getElementById('dropZone');
    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        }, false);
    });
    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            dropZone.classList.remove('dragover');
        }, false);
    });

    // 4. Anteprima immagine
    function mostraAnteprima(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('previewImg').style.display = 'block';
                document.getElementById('uploadTextContent').style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // 5. Apertura Modale (CORRETTA FIRMA PER ALTEZZA E PESO)
    function apriModaleAtleta(id, nome, cognome, password, foto, attivo, infortunato = false, riabilitazione = false, descrizione = '', altezza = 0, peso = 0) {
        document.getElementById('atletaId').value = id;
        document.getElementById('nome').value = nome;
        document.getElementById('cognome').value = cognome;
        document.getElementById('password').value = ""; // Lasciamo vuota la password in modifica per motivi di sicurezza
        document.getElementById('isAttivo').checked = attivo;

        document.getElementById('altezza').value = altezza;
        document.getElementById('peso').value = peso;

        document.getElementById('isInfortunato').checked = infortunato;
        document.getElementById('isInRiabilitazione').checked = riabilitazione;
        document.getElementById('descrizioneInfortunio').value = descrizione;

        aggiornaVisibilitaNote();

        document.getElementById('fotoUrlCorrente').value = foto;
        document.getElementById('uploadImmagine').value = '';

        if (foto && !foto.includes('default.png')) {
            document.getElementById('previewImg').src = foto;
            document.getElementById('previewImg').style.display = 'block';
            document.getElementById('uploadTextContent').style.display = 'none';
        } else {
            document.getElementById('previewImg').style.display = 'none';
            document.getElementById('uploadTextContent').style.display = 'block';
        }

        document.getElementById('modalTitle').innerText = id === 0 ? "Nuovo Giocatore" : "Modifica " + nome;

        var myModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('atletaModal'));
        myModal.show();
    }
</script>